    <string name="auth_mode_sign_in">Anmelden</string>
    <string name="auth_mode_create_account">Konto erstellen</string>
    <string name="auth_field_email">E-Mail</string>
    <string name="auth_field_username">Benutzername</string>
    <string name="auth_username_supporting_text">3–20 Zeichen: Buchstaben, Zahlen, Unterstrich. Daran finden dich deine Freunde.</string>
    <string name="auth_field_password">Passwort</string>
    <string name="auth_password_supporting_text_format">Mindestens %1$d Zeichen. Länge schlägt Sonderzeichen — ein kurzer Satz funktioniert gut.</string>
    <string name="auth_hide_password_content_description">Passwort ausblenden</string>
    <string name="auth_show_password_content_description">Passwort anzeigen</string>
    <string name="auth_forgot_password">Passwort vergessen?</string>
    <string name="auth_before_you_start_label">Bevor du startest</string>
    <string name="auth_before_you_start_body">Nichts wird hochgeladen, bis du es einschaltest — Kategorie für Kategorie. Dein GPS-Verlauf und deine Statistiken werden auf diesem Handy verschlüsselt, bevor sie es verlassen, sodass sie vom Server nicht gelesen und niemals mit jemandem geteilt werden können.</string>
    <string name="auth_terms_gate_text">Ich bin 18 Jahre oder älter und akzeptiere die Nutzungsbedingungen und die Datenschutzerklärung.</string>
    <string name="auth_terms_of_use">Nutzungsbedingungen</string>
    <string name="auth_privacy_policy">Datenschutzerklärung</string>
    <string name="auth_notice_account_created">Konto erstellt. Bestätige deine E-Mail-Adresse und melde dich dann an.</string>
    <string name="auth_error_invalid_credentials">Diese Kombination aus E-Mail und Passwort hat nicht funktioniert.</string>
    <string name="auth_error_username_taken">Dieser Benutzername ist bereits vergeben.</string>
    <string name="auth_error_invalid_username">Benutzernamen haben 3–20 Zeichen: Buchstaben, Zahlen und Unterstriche.</string>
    <string name="auth_error_invalid_email">Das sieht nicht wie eine E-Mail-Adresse aus.</string>
    <string name="auth_error_weak_password_format">Das Passwort muss mindestens %1$d Zeichen haben.</string>
    <string name="auth_error_terms_not_accepted">Du musst die Bedingungen akzeptieren, um ein Konto zu erstellen.</string>
    <string name="auth_error_email_not_confirmed">Bestätige zuerst deine E-Mail-Adresse — sieh in deinem Posteingang nach.</string>
    <string name="auth_error_rate_limited">Zu viele Versuche. Warte ein paar Minuten und versuch es erneut.</string>
    <string name="auth_error_offline">Server nicht erreichbar. Prüf deine Verbindung — der Rest der App funktioniert offline.</string>
    <string name="auth_error_unknown">Etwas ist schiefgelaufen. Versuch es erneut.</string>

    <!-- ===== ui/auth/CloudEntryScreen.kt ===== -->
    <string name="cloud_entry_disabled_title">Cloud ist nicht eingerichtet</string>
    <string name="cloud_entry_disabled_body">Diese Version hat keine Supabase-Zugangsdaten, daher sind Konten und Teilen nicht verfügbar. Alles andere funktioniert wie gewohnt.</string>
    <string name="cloud_entry_signed_in_title">Angemeldet</string>
    <string name="cloud_entry_settings_pill">Backup, Teilen &amp; Wiederherstellung</string>
    <string name="cloud_entry_sign_out">Abmelden</string>
    <string name="cloud_entry_delete_account">Konto löschen</string>
    <string name="cloud_entry_delete_confirm_title">Dein Konto löschen?</string>
    <string name="cloud_entry_delete_confirm_body">Dies löscht deine Cloud-Daten dauerhaft: Autos, Events, Trophäen, Freundschaften und verschlüsselte Backups. Das kann nicht rückgängig gemacht werden.\n\nAuf diesem Handy gespeicherte Daten sind davon nicht betroffen — deine Fahrten, deine Garage und deine Events bleiben hier.</string>

    <!-- ===== ui/auth/PasswordResetScreen.kt ===== -->
    <string name="password_reset_check_email_title">Prüf deine E-Mails</string>
    <string name="password_reset_title">Setz dein Passwort zurück</string>
    <string name="password_reset_sent_body_format">Falls %1$s zu einem Konto gehört, ist ein Reset-Link unterwegs. Öffne ihn auf diesem Handy, damit die App ihn erkennt und du ein neues Passwort wählen kannst.</string>
    <string name="password_reset_email_hint">Wir schicken dir einen Link per E-Mail, der diese App öffnet.</string>
    <string name="password_reset_send_link_button">Reset-Link senden</string>
    <string name="password_reset_changed_title">Passwort geändert</string>
    <string name="password_reset_choose_new_title">Wähl ein neues Passwort</string>
    <string name="password_reset_backups_restored">Dein verschlüsselter GPS-Verlauf und deine Statistiken wurden ebenfalls wiederhergestellt.</string>
    <string name="password_reset_new_password_field">Neues Passwort</string>
    <string name="password_reset_new_password_supporting_format">Mindestens %1$d Zeichen.</string>
    <string name="password_reset_encrypted_backups_label">Verschlüsselte Backups</string>
    <string name="password_reset_recovery_explainer">Wenn du deinen Wiederherstellungscode hast, gib ihn ein, um auch deinen verschlüsselten GPS-Verlauf und deine Statistiken wiederherzustellen. Ohne ihn kommt dein Konto trotzdem zurück, aber diese Daten können von niemandem entschlüsselt werden — der Schlüssel stammte aus dem Passwort, das du gerade ersetzt — und sie werden verworfen.</string>
    <string name="password_reset_recovery_code_field">Wiederherstellungscode (optional)</string>
    <string name="password_reset_set_button">Neues Passwort festlegen</string>
    <string name="password_reset_failed">Das neue Passwort konnte nicht festgelegt werden. Der Link ist möglicherweise abgelaufen — fordere einen neuen an.</string>

    <!-- ===== ui/auth/RecoveryCodeScreen.kt ===== -->
    <string name="recovery_code_new_title">Dein neuer Wiederherstellungscode</string>
    <string name="recovery_code_title">Dein Wiederherstellungscode</string>
    <string name="recovery_code_write_down">Schreib ihn dir irgendwo sicher auf. Er wird dir nicht noch einmal angezeigt.</string>
    <string name="recovery_code_previous_discarded_label">Vorherige Backups verworfen</string>
    <string name="recovery_code_previous_discarded_body">Dein Passwort wurde ohne funktionierenden Wiederherstellungscode zurückgesetzt, daher konnten der GPS-Verlauf und die Statistiken, die unter dem alten Passwort verschlüsselt waren, von niemandem entschlüsselt werden und wurden gelöscht. Ab jetzt erstellte Backups verwenden diesen neuen Code.</string>
    <string name="recovery_code_copy_button">Kopieren</string>
    <string name="recovery_code_clip_label">Car Companion Wiederherstellungscode</string>
    <string name="recovery_code_what_for_label">Wofür das ist</string>
    <string name="recovery_code_what_for_body">Dein GPS-Verlauf und deine Statistiken werden auf diesem Handy verschlüsselt, bevor sie hochgeladen werden. Niemand sonst kann sie lesen — weder andere Nutzer noch der Server noch wir.\n\nDer Schlüssel stammt aus deinem Passwort. Wenn du dein Passwort vergisst, ist dieser Code der einzige Weg zurück zu diesen Daten. Verlierst du beides, sind sie unwiderruflich verloren: Dein Konto und alles andere funktionieren trotzdem weiter, aber diese verschlüsselten Backups kann dann niemand mehr wiederherstellen.</string>
    <string name="recovery_code_confirm_saved">Ich habe meinen Wiederherstellungscode sicher aufbewahrt.</string>
    <string name="recovery_code_continue_button">Weiter</string>

    <!-- ===== data/cloud/CloudPrefsRepository.kt enums ===== -->
    <string name="visibility_private_label">Nur ich</string>
    <string name="visibility_private_desc">Nichts, was dir gehört, ist für jemand anderen sichtbar.</string>
    <string name="visibility_friends_label">Nur Freunde</string>
    <string name="visibility_friends_desc">Nur Personen, die du als Freunde hinzugefügt hast, können geteilte Inhalte sehen.</string>
    <string name="visibility_public_label">Alle</string>
    <string name="visibility_public_desc">Jeder mit einem Konto kann die Inhalte sehen, die du als geteilt markierst.</string>
    <string name="feed_scope_friends_label">Nur Freunde</string>
    <string name="feed_scope_everyone_label">Alle</string>
    <string name="leaderboard_visibility_private_label">Nur ich</string>
    <string name="leaderboard_visibility_private_desc">Du erscheinst auf der Bestenliste von niemand anderem, kannst aber deinen eigenen Rang sehen.</string>
    <string name="leaderboard_visibility_friends_label">Nur Freunde</string>
    <string name="leaderboard_visibility_friends_desc">Nur Personen, die du als Freunde hinzugefügt hast, können dein Level und deine XP auf der Bestenliste sehen.</string>
    <string name="leaderboard_visibility_public_label">Alle</string>
    <string name="leaderboard_visibility_public_desc">Jeder mit einem Konto kann dein Level und deine XP auf der Bestenliste sehen.</string>

    <!-- ===== ui/leaderboard/LeaderboardScreen.kt ===== -->
    <string name="leaderboard_scope_friends_label">Nur Freunde</string>
    <string name="leaderboard_scope_everyone_label">Alle</string>
    <string name="leaderboard_xp_format">%1$d XP</string>
    <string name="leaderboard_empty">Noch niemand anzuzeigen — füge Freunde hinzu oder wechsle zu Alle.</string>
    <string name="sync_category_cars_label">Autos</string>
    <string name="sync_category_cars_desc">Deine Garage: Marken, Modelle, Kilometerstand, Modifikationen. Fotos bleiben immer auf diesem Handy.</string>
    <string name="sync_category_events_label">Events</string>
    <string name="sync_category_events_desc">Treffen, Rennstreckentage und Erkundungen, einschließlich ihrer GPS-Aufzeichnung.</string>
    <string name="sync_category_profile_label">Persönliche Informationen</string>
    <string name="sync_category_profile_desc">Alter, Stadt und die Départements, in denen du dich gerne triffst.</string>
    <string name="sync_category_gps_history_label">GPS-Verlauf</string>
    <string name="sync_category_gps_history_desc">Jede aufgezeichnete Fahrt. Vor dem Hochladen auf diesem Handy verschlüsselt — der Server kann sie nicht lesen, und sie kann niemals geteilt werden.</string>
    <string name="sync_category_statistics_label">Statistiken</string>
    <string name="sync_category_statistics_desc">Gesamtwerte für Distanz, Geschwindigkeit und Fahrzeit. Verschlüsselt und niemals teilbar.</string>
    <string name="sync_category_trophies_label">Trophäen</string>
    <string name="sync_category_trophies_desc">Welche Erfolge du freigeschaltet hast.</string>
    <string name="profile_section_personal_info_label">Persönliche Infos</string>
    <string name="profile_section_personal_info_desc">Deine Stadt und die Départements, in denen du dich gerne triffst. Schaltet auch das Backup der persönlichen Informationen ein, falls noch nicht geschehen.</string>
    <string name="profile_section_garage_label">Garage</string>
    <string name="profile_section_garage_desc">Fügt deinem Profil einen Garage-Bereich hinzu, der die Autos auflistet, die du einzeln als geteilt markiert hast. Schaltet auch das Auto-Backup ein, falls noch nicht geschehen.</string>
    <string name="profile_section_trophies_label">Trophäen</string>
    <string name="profile_section_trophies_desc">Zeigt, welche Erfolge du freigeschaltet hast, und lässt deine Freischaltungen im Feed deiner Freunde erscheinen. Schaltet auch das Trophäen-Backup ein, falls noch nicht geschehen.</string>

    <!-- ===== ui/cloud/CloudSettingsScreen.kt ===== -->
    <string name="cloud_settings_backup_label">In der Cloud sichern</string>
    <string name="cloud_settings_backup_hint">Standardmäßig aus. Jede Kategorie ist deine Wahl und kann jederzeit wieder ausgeschaltet werden.</string>
    <string name="cloud_settings_visibility_label">Wer sehen kann, was du teilst</string>
    <string name="cloud_settings_visibility_hint">Gilt nur für Inhalte, die du einzeln als geteilt markierst (ein Auto, ein Event). Dein GPS-Verlauf und deine Statistiken sind bei keiner Einstellung für irgendjemanden sichtbar.</string>
    <string name="cloud_settings_feed_scope_label">Dein Feed zeigt</string>
    <string name="cloud_settings_leaderboard_visibility_label">Wer dich auf der Bestenliste sehen kann</string>
    <string name="cloud_settings_leaderboard_visibility_hint">Unabhängig davon, wer oben geteilte Inhalte sehen kann — du kannst auf der Bestenliste antreten und alles andere privat halten, oder umgekehrt.</string>
    <string name="cloud_settings_profile_sections_label">Auf deiner Profilseite</string>
    <string name="cloud_settings_profile_sections_hint">Standardmäßig aus. Ein Freund, der dein Profil besucht, sieht hier nichts, bis du einen Bereich einschaltest — selbst wenn er schon gesichert ist, und selbst bei „Alle“.</string>
